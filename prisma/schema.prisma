datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  type             String           // Residential, Commercial, Mixed Use, Luxury, Other
  status           String           // Upcoming, Ongoing, Completed
  shortDescription String
  description      String
  developer        String           @default("Keystone Developments")
  address          String
  area             String           // Location / Area
  city             String
  state            String
  pincode          String
  latitude         Float?
  longitude        Float?
  googleMapsUrl    String?
  totalArea        String?          // e.g. "12 Acres" or "500,000 sq.ft"
  buildings        Int?
  floors           Int?
  units            Int?
  completionDate   String?
  featured         Boolean          @default(false)
  published        Boolean          @default(true)
  seoTitle         String?
  metaDescription  String?
  images           ProjectImage[]
  amenities        ProjectAmenity[]
  floorPlans       FloorPlan[]
  brochures        Brochure[]
  inquiries        Inquiry[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProjectAmenity {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
}

model FloorPlan {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String
  createdAt   DateTime @default(now())
}

model Brochure {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String   @default("Project_Brochure.pdf")
  createdAt DateTime @default(now())
}

model Inquiry {
  id               String   @id @default(uuid())
  name             String
  phone            String
  email            String
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  message          String
  preferredContact String   @default("PHONE")
  visitDate        String?
  status           String   @default("NEW")
  createdAt        DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  designation String
  review      String
  image       String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Settings {
  id                String   @id @default("site_settings")
  companyName       String   @default("Keystone Real Estate Developments")
  phone             String   @default("+91 9217668175")
  whatsapp          String   @default("+91 9217668175")
  email             String   @default("shrishyamproperties001@gmail.com")
  address           String   @default("Vardhaman City Mall, Dwarka, Delhi")
  workingHours      String   @default("Monday - Sunday: 9:00 AM - 8:00 PM (7 Days Open)")
  siteTitle         String   @default("Keystone | Premium Real Estate Projects Showcase")
  siteDescription   String   @default("Explore luxury residential and commercial developments built for modern living and lasting value.")
  projectsDelivered String   @default("48+")
  yearsExperience   String   @default("15+")
  happyCustomers    String   @default("12,500+")
  ongoingProjects   String   @default("12")
  updatedAt         DateTime @updatedAt
}
